# ── Sticker Stop Environment Config ─────────────────────────────────────────
# Copy this file to ".env" and fill in your values.

# Neon Postgres connection string (free at neon.tech — no credit card required)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Admin panel password (change this!)
ADMIN_PASSWORD=stickerstop2024

# Comma-separated list of emails that get notified for every new order
NOTIFICATION_EMAILS=you@example.com

# ── Email (SMTP) Settings ────────────────────────────────────────────────────
# Leave blank to skip email sending — orders will still save to the database.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password   ← generate at myaccount.google.com/apppasswords
#   SMTP_FROM=Sticker Stop <you@gmail.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
